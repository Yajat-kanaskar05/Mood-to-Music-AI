# =============================================================================
# Mood-to-Music AI — Git Ignore Rules
# Full-Stack Microservices: Python/FastAPI + Node.js/Express + React/Vite
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Node.js & Dependencies
# -----------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# -----------------------------------------------------------------------------
# 2. Python & Virtual Environments
# -----------------------------------------------------------------------------
venv/
venv*/
env/
env*/
.venv/
.venv*/
ENV/
*.py[cod]
*$py.class
__pycache__/
*/__pycache__/
*/*/__pycache__/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
*.egg

# -----------------------------------------------------------------------------
# 3. Environment Variables & Secrets (NEVER commit credentials/JWT secrets)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example

# -----------------------------------------------------------------------------
# 4. Databases & SQLite Runtime Files (Contains local user accounts & history)
# -----------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite*
backend-node/data/*.db*
backend-node/src/data/*.db*

# -----------------------------------------------------------------------------
# 5. Datasets (Large CSV files downloaded from Kaggle or generated by scripts)
# -----------------------------------------------------------------------------
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# -----------------------------------------------------------------------------
# 6. ML Model Artifacts & Weights (Trained locally)
# NOTE: If you need these in GitHub for direct cloud deployment without cloud storage,
# you can comment these two lines out (both files are ~17-21 MB, below GitHub's 100MB limit).
# -----------------------------------------------------------------------------
models/*.pkl
models/*.pth
models/*.pt
models/*.h5
models/*.bin
models/*.onnx
models/*.joblib
!models/.gitkeep

# -----------------------------------------------------------------------------
# 7. Jupyter Notebook Checkpoints
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# 8. Frontend Production Builds & Package Manager Logs
# -----------------------------------------------------------------------------
frontend/dist/
frontend/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# 9. Operating System & Editor Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

